PORT=4000

# Authentication
# Set COOKIE_SECURE=true behind HTTPS. Create the initial admin only by running
# `ADMIN_USERNAME=... ADMIN_PASSWORD=... npm run create-admin`.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Local Ollama network assistant. Start Ollama with `ollama serve` and set
# LLM_MODEL only after the Phase 2 benchmark has been reviewed and a model selected.
# Ollama's OpenAI-compatible endpoint does not require a real secret; the
# placeholder keeps the request format compatible with the server adapter.
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_MS=180000
# Phase 6 target has 2–4 physical CPU cores; begin at the available core count.
OLLAMA_NUM_THREADS=4
# Router transport is detected from the local endpoint. Set explicitly only when needed:
# TOOL_ROUTER_TRANSPORT=ollama
# TOOL_ROUTER_TRANSPORT=openai
# Optional Nominatim-compatible geocoder base URL for natural-language address queries
# GEOCODE_BASE_URL=https://nominatim.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fiber_network

# Phase 5 RAG index. Run `npm run docs:index` after documentation changes.
DOC_INDEX_PATH=./data/docs.sqlite
DOC_EMBEDDING_MODEL_ID=Xenova/all-MiniLM-L6-v2
# Optional local model directory (overrides DOC_EMBEDDING_MODEL_ID when set).
# DOC_EMBEDDING_MODEL_PATH=./.runtime-assets/embedding-model
TRANSFORMERS_CACHE=./.runtime-assets/transformers-cache
DOC_EMBEDDING_OFFLINE=0
DOC_EMBEDDING_THREADS=1
DOCS_TOP_K=3
DOCS_MIN_SIMILARITY=0.20
DOC_MAX_CHUNK_TOKENS=240
DOC_TARGET_CHUNK_TOKENS=220

# Phase 6 provider settings. The router normalizes local and cloud inference to {tool,args}.
# Native Ollama uses its structured /api/chat endpoint; local llama.cpp uses port 8080.
AI_PROVIDER=local
AI_REQUEST_TIMEOUT_MS=180000
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Set LOCAL_LLM_MODEL only after Phase 2 model review; no model is selected by default.
# Optional local API key for a protected llama-server endpoint.
# LOCAL_LLM_API_KEY=

# Cloud alternative. Set AI_PROVIDER=cloud and supply the model/key.
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_API_KEY=replace-me
# CLOUD_LLM_MODEL=gpt-4o-mini

# Offline bundle build/runtime paths (model assets are deliberately gitignored).
# LLAMA_SERVER_BIN=./.runtime-assets/llama.cpp/build/bin/llama-server
# LLAMA_MODEL_PATH=/path/to/the-reviewed-model.gguf (set only after Phase 2 review)
# LOCAL_LLM_MODEL=<reviewed-model-identifier>
# LLAMA_PORT=8080
# LLAMA_THREADS=2
# LLAMA_CTX_SIZE=4096

# Used only in production (knexfile.js production block)
# DATABASE_URL=postgres://user:pass@host:5432/fiber_network
