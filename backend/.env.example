PORT=4000

# Authentication
# Set COOKIE_SECURE=true behind HTTPS. Create the initial admin only by running
# `ADMIN_USERNAME=... ADMIN_PASSWORD=... npm run create-admin`.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Local Ollama network assistant. Start Ollama, then make sure the model exists:
# `ollama serve` and `ollama pull llama3.2:1b`.
# Ollama's OpenAI-compatible endpoint does not require a real secret; the
# placeholder keeps the request format compatible with the server adapter.
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:1b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_TIMEOUT_MS=180000
# llama.cpp computation threads. Start with your physical CPU core count and
# tune downward if the machine becomes unresponsive.
OLLAMA_NUM_THREADS=8
# Set to deterministic for offline development without an LLM.
NETWORK_QUERY_PLANNER=llm
# Optional Nominatim-compatible geocoder base URL for natural-language address queries
# GEOCODE_BASE_URL=https://nominatim.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fiber_network

# Used only in production (knexfile.js production block)
# DATABASE_URL=postgres://user:pass@host:5432/fiber_network
