PORT=4000

# Authentication
# Set COOKIE_SECURE=true behind HTTPS. Create the initial admin only by running
# `ADMIN_USERNAME=... ADMIN_PASSWORD=... npm run create-admin`.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Optional service-to-service token for POST /api/telemetry/events and /ingest
# TELEMETRY_INGEST_TOKEN=replace-with-a-long-random-token
# Natural-language graph query planner. The query route requires an LLM by default;
# never put this key in frontend code. Gemini native API is the default setup.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OpenAI-compatible providers are also supported. For the temporary OpenRouter
# integration use these values (keep the key server-side and never commit it):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Fiberline
# For Groq use these values:
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# For a generic OpenAI provider use LLM_PROVIDER=openai, LLM_API_KEY,
# LLM_MODEL, and LLM_BASE_URL.
LLM_TIMEOUT_MS=15000
# Use only for an offline/local development fallback; production should remain `llm`.
NETWORK_QUERY_PLANNER=llm
# Optional Nominatim-compatible geocoder base URL for natural-language address queries
# GEOCODE_BASE_URL=https://nominatim.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fiber_network

# Used only in production (knexfile.js production block)
# DATABASE_URL=postgres://user:pass@host:5432/fiber_network
