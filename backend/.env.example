PORT=4000

# Authentication
# Set COOKIE_SECURE=true behind HTTPS. Create the initial admin only by running
# `ADMIN_USERNAME=... ADMIN_PASSWORD=... npm run create-admin`.
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Default runtime: local llama.cpp with the selected Qwen2.5-1.5B Q4_K_M.
# Optional Ollama override: set LLM_BASE_URL and LLM_MODEL to your installed tag,
# and remove LOCAL_LLM_BASE_URL/LOCAL_LLM_MODEL below so they do not take precedence.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
LLM_TIMEOUT_MS=180000
# Phase 6 target has 2–4 physical CPU cores; begin at the available core count.
OLLAMA_NUM_THREADS=4
# Router transport is detected from the local endpoint. Set explicitly only when needed:
# TOOL_ROUTER_TRANSPORT=ollama
# TOOL_ROUTER_TRANSPORT=openai
# Optional Nominatim-compatible geocoder base URL for natural-language address queries
# GEOCODE_BASE_URL=https://nominatim.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fiber_network

# Phase 5 RAG index. Run `npm run docs:index` after documentation changes.
DOC_INDEX_PATH=./data/docs.sqlite
DOC_EMBEDDING_MODEL_ID=Xenova/all-MiniLM-L6-v2
# Optional local model directory (overrides DOC_EMBEDDING_MODEL_ID when set).
# DOC_EMBEDDING_MODEL_PATH=./.runtime-assets/embedding-model
TRANSFORMERS_CACHE=./.runtime-assets/transformers-cache
DOC_EMBEDDING_OFFLINE=0
DOC_EMBEDDING_THREADS=1
DOCS_TOP_K=3
DOCS_MIN_SIMILARITY=0.20
DOC_MAX_CHUNK_TOKENS=240
DOC_TARGET_CHUNK_TOKENS=220

# Phase 6 provider settings. The router normalizes local and cloud inference to {tool,args}.
# Native Ollama uses its structured /api/chat endpoint; local llama.cpp uses port 8080.
AI_PROVIDER=local
AI_REQUEST_TIMEOUT_MS=180000
# Startup warms the actual router prefix once before the API listens.
# Start llama-server first; the offline launcher starts and health-checks it.
# A warm-up failure fails startup. Cloud mode sends no startup inference.
# Native llama.cpp should use --parallel 1 for this single-user CPU deployment.
# Set to 0 only for non-llama local APIs that reject the cache_prompt extension:
# TOOL_ROUTER_CACHE_PROMPT=0
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMA_MODEL_PATH=./models/gguf/qwen2.5-1.5b-instruct-q4_k_m.gguf
# Optional local API key for a protected llama-server endpoint.
# LOCAL_LLM_API_KEY=

# Cloud alternative. Set AI_PROVIDER=cloud and supply the model/key.
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_API_KEY=replace-me
# CLOUD_LLM_MODEL=gpt-4o-mini

# Offline bundle build/runtime paths (model assets are deliberately gitignored).
# npm run llama:build uses a prebuilt installation on Windows (no Bash/WSL).
# Default Windows directory; override LLAMA_CPP_DIR if you move the download:
# LLAMA_CPP_DIR='C:/Users/sws/Desktop/web product images/llama-b11435-bin-win-cpu-x64'
# Keep the entire archive extracted together, including DLLs. The setup command
# saves LLAMA_CPP_DIR and LLAMA_SERVER_BIN in backend/.env for subsequent scripts.
# On Linux/macOS, omit both paths to build from source, or set a native prebuilt path.
# LLAMA_SERVER_BIN=./.runtime-assets/llama.cpp-src/build/bin/llama-server
# Explicit LLAMA_MODEL_PATH / LOCAL_LLM_MODEL overrides can select another local model.
# LLAMA_PORT=8080
# LLAMA_THREADS=2
# LLAMA_CTX_SIZE=4096

# Used only in production (knexfile.js production block)
# DATABASE_URL=postgres://user:pass@host:5432/fiber_network
